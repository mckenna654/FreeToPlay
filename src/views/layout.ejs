<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f0f10">
    <title><%= currentPath === '/sessions/new' ? 'Host a session' : typeof session !== 'undefined' ? session.title : 'The lobby' %> · FreeToPlay</title>
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/styles.css" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <script src="/app.js" defer></script>
</head>
<body>
    <a href="#main" class="skip-link">Skip to content</a>
    <aside class="sidebar">
        <a href="/" class="brand" aria-label="FreeToPlay home"><span class="brand-mark" aria-hidden="true"><%- include('partials/controller') %></span><span class="brand-word">FREE<span>TO</span>PLAY</span></a>
        <div class="sidebar-middle">
            <nav aria-label="Main navigation">
                <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>" <%- currentPath === '/' ? 'aria-current="page"' : '' %>><%- include('partials/icon', { name: 'layout-grid' }) %> The lobby</a>
                <% if (user) { %><a href="/?filter=mine&view=agenda" class="nav-link"><%- include('partials/icon', { name: 'ticket' }) %> My sessions</a><% } %>
                <a href="/sessions/new" class="nav-link <%= currentPath === '/sessions/new' ? 'active' : '' %>"><%- include('partials/icon', { name: 'plus' }) %> Host a session</a>
            </nav>
            <% if (typeof activeMembers !== 'undefined' && activeMembers.length) { %>
                <section class="members"><p class="sidebar-label">The crew</p><div class="avatar-stack"><% activeMembers.forEach(m => { %><%- include('partials/avatar', { person: m }) %><% }) %></div></section>
            <% } %>
        </div>
        <div class="account">
            <% if (user) { %><span class="avatar"><% if (user.avatar) { %><img src="<%= user.avatar %>" alt=""><% } else { %><%= user.username.slice(0, 1).toUpperCase() %><% } %></span><div><strong><%= user.username %></strong><a href="/logout">Sign out</a></div>
            <% } else { %><a href="/auth/discord" class="button button-secondary">Connect Discord</a><small>Sign in to host or join a session</small><% } %>
        </div>
    </aside>
    <main id="main" tabindex="-1">
        <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
        <%- body %>
        <footer class="site-footer"><span>FreeToPlay</span><span>Game discovery by IGDB</span></footer>
    </main>
    <div id="toast" class="toast" role="status" hidden></div>
</body>
</html>
