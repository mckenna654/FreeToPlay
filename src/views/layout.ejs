<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreeToPlay</title>
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-gray-900 text-white font-sans min-h-screen">
    <nav class="bg-gray-800 p-4 shadow-md">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-indigo-400">🎮 FreeToPlay</a>
            <div>
                <% if (user) { %>
                    <div class="flex items-center gap-4">
                        <% if (user.avatar) { %>
                            <img src="<%= user.avatar %>" alt="avatar" class="w-8 h-8 rounded-full">
                        <% } %>
                        <span class="font-medium"><%= user.username %></span>
                        <a href="/sessions/new" class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-md text-sm transition-colors">Schedule Session</a>
                        <a href="/logout" class="text-gray-400 hover:text-white text-sm">Logout</a>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="bg-[#5865F2] hover:bg-[#4752C4] px-4 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2">
                        Login with Discord
                    </a>
                <% } %>
            </div>
        </div>
    </nav>
    <main class="max-w-6xl mx-auto p-4 mt-8">
        <%- body %>
    </main>
</body>
</html>
