<% const count = s.rsvps.filter(r => r.status === 'CONFIRMED').length; %><a href="/sessions/<%= s.id %>" class="calendar-event <%= s.startTime < new Date() ? 'past-event' : '' %>" data-start="<%= s.startTime.toISOString() %>"><time class="event-time" data-local-hour datetime="<%= s.startTime.toISOString() %>"><%= format(s.startTime, 'h:mm a') %></time><strong><%= s.title %></strong><span class="event-game"><%= s.gameTitle %></span><span class="event-slots"><%- include('seats', { taken: count, total: s.maxPlayers }) %><span><%= count %>/<%= s.maxPlayers %></span></span></a>