<div class="p-6 md:p-10 max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-8">
        <div>
            <div class="flex items-center gap-4">
                <a href="/?month=<%= prevMonth %>" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </a>
                <h1 class="text-3xl font-black text-slate-100 min-w-[200px] text-center"><%= format(monthStart, 'MMMM yyyy') %></h1>
                <a href="/?month=<%= nextMonth %>" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
            </div>
            <p class="text-slate-400 mt-2">Schedule and join upcoming game sessions</p>
        </div>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl">
        <!-- Days of Week Header -->
        <div class="grid grid-cols-7 border-b border-slate-800 bg-slate-900/50">
            <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach(day => { %>
                <div class="py-3 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">
                    <%= day %>
                </div>
            <% }) %>
        </div>

        <!-- Calendar Grid -->
        <div class="grid grid-cols-7 bg-slate-800 gap-[1px]">
            <% calendarDays.forEach(day => { %>
                <% 
                    const isCurrentMonth = isSameMonth(day, monthStart);
                    const today = isToday(day);
                    // Find sessions for this day
                    const daySessions = sessions.filter(s => {
                        const sDate = new Date(s.startTime);
                        return sDate.getDate() === day.getDate() && 
                               sDate.getMonth() === day.getMonth() && 
                               sDate.getFullYear() === day.getFullYear();
                    });
                %>
                
                <div class="min-h-[120px] bg-slate-900 p-2 <%= !isCurrentMonth ? 'opacity-40' : '' %> <%= today ? 'bg-slate-800/50' : '' %> transition-colors hover:bg-slate-800/80">
                    <div class="flex justify-between items-start">
                        <span class="text-sm font-semibold <%= today ? 'bg-emerald-500 text-slate-950 w-6 h-6 flex items-center justify-center rounded-full' : 'text-slate-400' %>">
                            <%= format(day, 'd') %>
                        </span>
                    </div>

                    <div class="mt-2 space-y-1.5">
                        <% daySessions.forEach(s => { %>
                            <a href="/sessions/<%= s.id %>" class="block relative overflow-hidden rounded-md group border border-slate-700 hover:border-emerald-500/50 transition-colors">
                                <% if(s.gameCoverUrl) { %>
                                    <div class="absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity">
                                        <img src="<%= s.gameCoverUrl %>" class="w-full h-full object-cover">
                                    </div>
                                <% } %>
                                <div class="relative p-1.5 z-10">
                                    <div class="text-[10px] font-bold text-emerald-400 mb-0.5">
                                        <%= format(new Date(s.startTime), 'h:mm a') %>
                                    </div>
                                    <div class="text-xs font-medium text-slate-200 truncate leading-tight">
                                        <%= s.title %>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>
