<div class="page form-page">
    <a class="back-link" href="/"><%- include('partials/icon', { name: 'arrow-left' }) %> Back to the lobby</a>
    <header class="page-heading"><h1>Host a session</h1><p class="intro">Pick a game and a time, then invite your crew.</p></header>
    <div class="form-layout"><form action="/sessions" method="POST" id="session-form" class="session-form">
        <% if (errors.length) { %><div class="notice error" role="alert"><strong>Let’s fix a few things</strong><ul><% errors.forEach(message => { %><li><%= message %></li><% }) %></ul></div><% } %>
        <section class="form-section"><h2>What are we playing?</h2>
            <div class="field game-field"><label for="gameTitle">Game <span>IGDB search or enter your own</span></label><input type="text" id="gameTitle" name="gameTitle" maxlength="150" required autocomplete="off" value="<%= values.gameTitle || '' %>" placeholder="Helldivers 2" aria-controls="autocomplete-results" aria-expanded="false" aria-autocomplete="list" role="combobox"><input type="hidden" id="imageUrl" name="imageUrl" value="<%= values.imageUrl || '' %>"><div id="autocomplete-results" class="autocomplete" role="listbox" aria-label="Game suggestions" hidden></div><p id="game-search-status" class="field-hint" role="status">Type at least 3 letters for game suggestions. Manual names work too.</p></div>
            <div class="field"><label for="title">Session name</label><input type="text" id="title" name="title" maxlength="100" required value="<%= values.title || '' %>" placeholder="Friday night bug hunt"><p class="field-hint">Give it a name your friends will recognise.</p></div>
        </section>
        <section class="form-section"><h2>When and who?</h2><div class="field-grid"><div class="field"><label for="date">Date</label><input type="date" id="date" name="date" required value="<%= values.date || '' %>"></div><div class="field"><label for="time">Start time</label><input type="time" id="time" name="time" required value="<%= values.time || '20:00' %>"></div><div class="field"><label for="maxPlayers">Players</label><input type="number" id="maxPlayers" name="maxPlayers" min="1" max="100" required value="<%= values.maxPlayers || 4 %>"></div></div><p class="field-hint" id="timezone-hint">Without JavaScript, times use <%= timeZone.replace(/_/g, ' ') %>.</p><input type="hidden" name="startTimeIso" id="startTimeIso"><p class="field-hint">Player count includes you. Your spot is saved automatically.</p></section>
        <section class="form-section"><h2>The plan <small>Optional</small></h2><div class="field"><label class="sr-only" for="description">Details and notes</label><textarea id="description" name="description" maxlength="2000" rows="4" placeholder="Casual runs or ranked grind? Where to meet? What to bring?"><%= values.description || '' %></textarea></div></section>
        <div class="form-actions"><a href="/" class="text-link">Cancel</a><button type="submit" class="button button-primary button-large">Create session</button></div>
    </form><aside class="session-preview"><p class="preview-label">Lobby preview</p><div class="session-ticket"><div class="game-art <%= values.imageUrl ? '' : 'art-fallback' %>" id="preview-art" data-art="0" data-title="Your game"><img id="preview-image" <% if (values.imageUrl) { %>src="<%= values.imageUrl %>"<% } else { %>hidden<% } %> alt="Selected game artwork"><span class="art-title" id="preview-game">Your game</span></div><div class="ticket-body"><div class="ticket-info"><h3 id="preview-title">Session name</h3><p id="preview-time">Date and time</p><p class="ticket-seats"><span class="seats" id="preview-seats" aria-hidden="true"></span><span class="availability"><span id="preview-players">4</span> player slots, one reserved for you</span></p></div></div></div><p class="preview-note">Your session will appear in the lobby. If the Discord bot is connected, your group gets an invite there too.</p></aside></div>
</div>
