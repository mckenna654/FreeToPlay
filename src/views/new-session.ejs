<div class="page form-page">
    <a class="back-link" href="/">← Back to the lobby</a>
    <header class="page-heading"><div><p class="eyebrow">CREATE A SESSION</p><h1>ASSEMBLE THE SQUAD<span class="accent">.</span></h1><p class="intro">Pick your game. Set the time. Rally your crew.</p></div></header>
    <div class="form-layout"><form action="/sessions" method="POST" id="session-form" class="session-form">
        <% if (errors.length) { %><div class="notice error" role="alert"><strong>Let’s fix a few things.</strong><ul><% errors.forEach(message => { %><li><%= message %></li><% }) %></ul></div><% } %>
        <section class="form-section"><div class="form-section-title"><span>01</span><h2>What are we playing?</h2></div>
            <div class="field game-field"><label for="gameTitle">Game <span>IGDB search or enter your own</span></label><input type="text" id="gameTitle" name="gameTitle" maxlength="150" required autocomplete="off" value="<%= values.gameTitle || '' %>" placeholder="Start with a game, e.g. Helldivers 2" aria-controls="autocomplete-results" aria-expanded="false" aria-autocomplete="list" role="combobox"><input type="hidden" id="imageUrl" name="imageUrl" value="<%= values.imageUrl || '' %>"><div id="autocomplete-results" class="autocomplete" role="listbox" aria-label="Game suggestions" hidden></div><p id="game-search-status" class="field-hint" role="status">Type at least 3 letters for game suggestions. Manual names work too.</p></div>
            <div class="field"><label for="title">Session name</label><input type="text" id="title" name="title" maxlength="100" required value="<%= values.title || '' %>" placeholder="Friday night bug hunt"><p class="field-hint">Give it a name your friends will recognize.</p></div>
        </section>
        <section class="form-section"><div class="form-section-title"><span>02</span><h2>When & who?</h2></div><div class="field-grid"><div class="field"><label for="date">Date</label><input type="date" id="date" name="date" required value="<%= values.date || '' %>"></div><div class="field"><label for="time">Start time</label><input type="time" id="time" name="time" required value="<%= values.time || '20:00' %>"></div><div class="field"><label for="maxPlayers">Players</label><input type="number" id="maxPlayers" name="maxPlayers" min="1" max="100" required value="<%= values.maxPlayers || 4 %>"></div></div><p class="field-hint" id="timezone-hint">Without JavaScript, times use <%= timeZone.replace(/_/g, ' ') %>.</p><input type="hidden" name="startTimeIso" id="startTimeIso"><p class="field-hint">Player count includes you. Your spot is saved automatically.</p></section>
        <section class="form-section"><div class="form-section-title"><span>03</span><h2>The plan <small>Optional</small></h2></div><div class="field"><label class="sr-only" for="description">Details and notes</label><textarea id="description" name="description" maxlength="2000" rows="4" placeholder="Casual runs? Ranked grind? Let everyone know what to expect, where to meet, or what to bring."><%= values.description || '' %></textarea></div></section>
        <div class="form-actions"><a href="/" class="text-link">Cancel</a><button type="submit" class="button button-primary">Create session <span aria-hidden="true">↗</span></button></div>
    </form><aside class="session-preview"><p class="eyebrow">LOBBY PREVIEW</p><div class="preview-art art-fallback"><span class="fallback-controller" aria-hidden="true"><%- include('partials/controller') %></span><img id="preview-image" <% if (values.imageUrl) { %>src="<%= values.imageUrl %>"<% } else { %>hidden<% } %> alt="Selected game artwork"></div><div class="preview-body"><span class="eyebrow" id="preview-game">Pick your game</span><h2 id="preview-title">Your next adventure.</h2><p id="preview-time">A time that works for your group.</p><hr><p><strong id="preview-players">4</strong> player slots<br><span class="muted">One already reserved for you.</span></p></div><div class="preview-note"><span aria-hidden="true">↗</span><p>Your session will appear in the lobby. If the Discord bot is connected, your group gets an invite there too.</p></div></aside></div>
</div>
