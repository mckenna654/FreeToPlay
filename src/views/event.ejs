<% const confirmed = session.rsvps.filter(r => r.status === 'CONFIRMED'); const spots = Math.max(0, session.maxPlayers - confirmed.length); const mine = user && session.rsvps.find(r => r.userId === user.id); const past = new Date(session.startTime) < new Date(); %>
<div class="page event-page">
    <a class="back-link" href="/"><%- include('partials/icon', { name: 'arrow-left' }) %> Back to the lobby</a>
    <header class="event-header"><div class="event-heading"><p class="event-game-name"><%= session.gameTitle %></p><h1><%= session.title %></h1><p class="intro">Hosted by <strong><%= session.creator.username %></strong><% if (past) { %> · Session started<% } %></p></div><div class="event-cover"><%- include('partials/art', { game: session.gameTitle, cover: session.gameCoverUrl, alt: session.gameTitle + ' artwork' }) %></div></header>
    <div class="event-facts"><div><span class="fact-label">When</span><strong><time data-local-date datetime="<%= session.startTime.toISOString() %>"><%= format(session.startTime, 'EEEE, d MMMM') %></time></strong><time data-local-clock datetime="<%= session.startTime.toISOString() %>"><%= format(session.startTime, 'h:mm a') %> · <%= timeZone %></time></div><div><span class="fact-label">The group</span><strong><%= confirmed.length %> of <%= session.maxPlayers %> going</strong><span class="ticket-seats"><%- include('partials/seats', { taken: confirmed.length, total: session.maxPlayers }) %><span class="availability"><%= spots ? spots + ' open spot' + (spots === 1 ? '' : 's') : 'Full house' %></span></span></div><div class="event-tools"><a class="button button-secondary" href="/sessions/<%= session.id %>/calendar.ics"><%- include('partials/icon', { name: 'calendar-plus' }) %> Add to calendar</a><button class="button button-secondary" type="button" data-share><%- include('partials/icon', { name: 'link' }) %> Copy invite link</button></div></div>
    <div class="event-layout"><div><section class="detail-section"><h2>The plan</h2><p class="session-description"><%= session.description || 'No special instructions. Bring yourself and a good game face.' %></p></section><section class="detail-section"><div class="section-heading"><h2>Who’s coming</h2><span class="section-count"><%= confirmed.length %> confirmed</span></div><div class="roster"><% session.rsvps.forEach(r => { %><div class="roster-row"><span class="avatar"><% if (r.user.avatar) { %><img src="<%= r.user.avatar %>" alt=""><% } else { %><%= r.user.username.slice(0, 1).toUpperCase() %><% } %></span><div><strong><%= r.user.username %></strong><% if (r.userId === session.creatorId) { %><small>Host</small><% } %></div><span class="rsvp-badge status-<%= r.status.toLowerCase() %>"><%= r.status === 'CONFIRMED' ? 'Going' : r.status === 'TENTATIVE' ? 'Maybe' : 'Can’t make it' %></span></div><% }) %><% if (!session.rsvps.length) { %><p class="muted">No one has joined yet. Grab the first slot.</p><% } %></div></section></div>
    <aside class="rsvp-panel"><section><h2><%= mine?.status === 'CONFIRMED' ? 'You’re on the list' : 'Coming along?' %></h2><p class="muted"><%= past ? 'This session has already started.' : 'Let the group know. You can change your answer anytime.' %></p><% if (user) { %><form action="/sessions/<%= session.id %>/rsvp" method="POST" class="rsvp-form"><% [['CONFIRMED', 'Count me in', 'check'], ['TENTATIVE', 'Maybe, keep me posted', 'circle-help'], ['DECLINED', 'Can’t make it', 'x']].forEach(([status, label, icon]) => { %><button name="status" value="<%= status %>" type="submit" class="rsvp-choice <%= mine?.status === status ? 'is-selected' : '' %>" aria-pressed="<%= mine?.status === status %>" <%= status === 'CONFIRMED' && !spots && mine?.status !== 'CONFIRMED' ? 'disabled' : '' %>><span><%= label %></span><%- include('partials/icon', { name: icon }) %></button><% }) %></form><% } else { %><a class="button button-primary" href="/auth/discord">Connect Discord to RSVP</a><% } %><p class="field-hint">RSVPs stay in sync with Discord.</p></section>
    <% if (user && user.id === session.creatorId) { %><section class="host-actions"><h3>Host controls</h3><p class="muted">Plans changed? Cancel the session and let the group know.</p><form action="/sessions/<%= session.id %>/delete" method="POST" data-confirm="Cancel this session? It will be removed from the lobby and the group will be notified in Discord."><button class="text-link danger" type="submit">Cancel this session</button></form></section><% } %></aside></div>
</div>
