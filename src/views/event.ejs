<% const cover = coverUrl(session.gameCoverUrl); const confirmed = session.rsvps.filter(r => r.status === 'CONFIRMED'); const spots = Math.max(0, session.maxPlayers - confirmed.length); const mine = user && session.rsvps.find(r => r.userId === user.id); const past = new Date(session.startTime) < new Date(); %>
<div class="page event-page">
    <a class="back-link" href="/">← Back to the lobby</a>
    <header class="event-header"><div class="event-heading"><p class="eyebrow"><span class="signal-dot"></span> <%= session.gameTitle %></p><h1><%= session.title %></h1><p class="intro">Hosted by <strong><%= session.creator.username %></strong><span class="caption-separator">/</span><%= past ? 'Session started' : 'Your next squad session' %></p></div><div class="event-cover <%= cover ? '' : 'art-fallback' %>"><% if (cover) { %><img src="<%= cover %>" alt="<%= session.gameTitle %> artwork"><% } else { %><span class="fallback-controller" aria-hidden="true"><%- include('partials/controller') %></span><% } %></div></header>
    <div class="event-facts"><div><span class="eyebrow">WHEN</span><strong><time data-local-date datetime="<%= session.startTime.toISOString() %>"><%= format(session.startTime, 'EEEE, d MMMM') %></time></strong><time data-local-clock datetime="<%= session.startTime.toISOString() %>"><%= format(session.startTime, 'h:mm a') %> · <%= timeZone %></time></div><div><span class="eyebrow">THE GROUP</span><strong><%= confirmed.length %> of <%= session.maxPlayers %> going</strong><span class="availability <%= spots ? '' : 'full' %>"><%= spots ? spots + ' open spot' + (spots === 1 ? '' : 's') : 'Full house' %></span></div><div class="event-tools"><a class="button button-secondary" href="/sessions/<%= session.id %>/calendar.ics">↓ Add to calendar</a><button class="button button-secondary" type="button" data-share>↗ Copy invite link</button></div></div>
    <div class="event-layout"><div><section class="detail-section"><p class="eyebrow">THE PLAN</p><h2>THE MISSION BRIEF</h2><p class="session-description"><%= session.description || 'No special instructions. Bring yourself and a good game face.' %></p></section><section class="detail-section"><div class="section-heading"><h2>THE ROSTER</h2><span class="eyebrow"><%= confirmed.length %> CONFIRMED</span></div><div class="capacity-track" role="meter" aria-label="Confirmed players" aria-valuenow="<%= Math.min(confirmed.length, session.maxPlayers) %>" aria-valuemin="0" aria-valuemax="<%= session.maxPlayers %>"><span style="width:<%= Math.min(100, confirmed.length / session.maxPlayers * 100) %>%"></span></div><div class="roster"><% session.rsvps.forEach(r => { %><div class="roster-row"><span class="avatar"><% if (r.user.avatar) { %><img src="<%= r.user.avatar %>" alt=""><% } else { %><%= r.user.username.slice(0, 1).toUpperCase() %><% } %></span><div><strong><%= r.user.username %></strong><% if (r.userId === session.creatorId) { %><small>Host</small><% } %></div><span class="rsvp-badge status-<%= r.status.toLowerCase() %>"><%= r.status === 'CONFIRMED' ? 'Going' : r.status === 'TENTATIVE' ? 'Maybe' : 'Can’t make it' %></span></div><% }) %><% if (!session.rsvps.length) { %><p class="muted">No one has joined yet. Grab the first slot.</p><% } %></div></section></div>
    <aside class="rsvp-panel"><section><p class="eyebrow">SAVE YOUR SPOT</p><h2><%= mine?.status === 'CONFIRMED' ? 'You’re on the list.' : 'Coming along?' %></h2><p class="muted"><%= past ? 'This session has already started.' : 'Let the group know. You can change your answer anytime.' %></p><% if (user) { %><form action="/sessions/<%= session.id %>/rsvp" method="POST" class="rsvp-form"><% [['CONFIRMED', 'Count me in', '✓'], ['TENTATIVE', 'Maybe, keep me posted', '~'], ['DECLINED', 'Can’t make it', '—']].forEach(([status, label, icon]) => { %><button name="status" value="<%= status %>" type="submit" class="rsvp-choice <%= mine?.status === status ? 'is-selected' : '' %>" aria-pressed="<%= mine?.status === status %>"><span><%= label %></span><span aria-hidden="true"><%= icon %></span></button><% }) %></form><% } else { %><a class="button button-primary" href="/auth/discord">Connect Discord to RSVP ↗</a><% } %><p class="field-hint">RSVPs stay in sync with Discord.</p></section>
    <% if (user && user.id === session.creatorId) { %><section class="host-actions"><p class="eyebrow">HOST CONTROLS</p><p class="muted">Plans changed? Cancel the session and let the group know.</p><form action="/sessions/<%= session.id %>/delete" method="POST" data-confirm="Cancel this session? It will be removed from the lobby and the group will be notified in Discord."><button class="text-link danger" type="submit">Cancel this session</button></form></section><% } %></aside></div>
</div>
